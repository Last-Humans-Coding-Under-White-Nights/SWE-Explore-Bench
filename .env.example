# Copy to .env and fill in your own values.
# All variables are read at runtime by the Python entry points and the
# example LiteLLM proxy config under configs/litellm_proxy.yaml.

# ── Generic OpenAI-compatible endpoint ───────────────────────────────────
# Used by the line-refine pipeline and any explorer that expects a plain
# OpenAI-style HTTP API (chat completions).
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# ── LiteLLM proxy (configs/litellm_proxy.yaml) ───────────────────────────
# The proxy fronts a single upstream chat-completions deployment so all
# academic agents can hit one base URL with one master key.
LLM_API_BASE=
LLM_API_KEY=
LLM_DEPLOYMENT=
PROXY_MASTER_KEY=

# ── Academic-agent client (eval_runner.py: --academic-*) ─────────────────
ACADEMIC_API_BASE=http://127.0.0.1:4000/v1
ACADEMIC_API_KEY=

# ── Optional: SweRank rerank API (--swerank-*) ───────────────────────────
SWERANK_API_BASE=
SWERANK_API_KEY=

# ── Agentic CLI explorers (--explorers opencode / deveco) ────────────────
# Each run redirects HOME to a temporary directory, so the user's global CLI 
# configuration is never picked up; point the config-dir flag at a checked-in profile instead.
#
#   --opencode-bin          path to the `opencode` binary (default: opencode)
#   --opencode-timeout      per-instance limit in seconds (default: 600)
#   --opencode-config-dir   directory holding an opencode.json; exported to the
#                           child process as OPENCODE_CONFIG_DIR
#   --opencode-prompt-additions
#                           extra instructions appended to the prompt
#
#   --deveco-bin            path to the `deveco` binary (default: deveco)
#   --deveco-timeout        per-instance limit in seconds (default: 600)
#   --deveco-config-dir     directory holding a deveco.json; exported to the
#                           child process as DEVECO_CONFIG_DIR. DevEco Code
#                           0.1.9 does not document this variable, so leave the
#                           flag unset unless you are verifying it yourself.
#   --deveco-prompt-additions
#                           extra instructions appended to the prompt
#   --no-deveco-skip-permissions
#                           drop --dangerously-skip-permissions, which is on by
#                           default so unattended runs do not stall on approval

# ── Optional: external academic-agent source checkouts ───────────────────
# Override default location ./third_party/explorer-codes/{auto-code-rover,
# CoSIL, LocAgent, OrcaLoca, AweAgent}, or override each path individually.
EXPLORER_CODES_ROOT=
AUTOCR_PATH=
COSIL_PATH=
LOCAGENT_PATH=
ORCALOCA_PATH=
AWE_AGENT_PATH=

# Optional: explicit conda binary used to launch external agents
CONDA_EXE=
