# Copy to .env and fill in your own values.
# All variables are read at runtime by the Python entry points and the
# example LiteLLM proxy config under configs/litellm_proxy.yaml.

# ── Generic OpenAI-compatible endpoint ───────────────────────────────────
# Used by the line-refine pipeline and any explorer that expects a plain
# OpenAI-style HTTP API (chat completions).
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# ── LiteLLM proxy (configs/litellm_proxy.yaml) ───────────────────────────
# The proxy fronts a single upstream chat-completions deployment so all
# academic agents can hit one base URL with one master key.
LLM_API_BASE=
LLM_API_KEY=
LLM_DEPLOYMENT=
PROXY_MASTER_KEY=

# ── Academic-agent client (eval_runner.py: --academic-*) ─────────────────
ACADEMIC_API_BASE=http://127.0.0.1:4000/v1
ACADEMIC_API_KEY=

# ── Optional: SweRank rerank API (--swerank-*) ───────────────────────────
SWERANK_API_BASE=
SWERANK_API_KEY=

# ── Optional: external academic-agent source checkouts ───────────────────
# Override default location ./third_party/explorer-codes/{auto-code-rover,
# CoSIL, LocAgent, OrcaLoca, AweAgent}, or override each path individually.
EXPLORER_CODES_ROOT=
AUTOCR_PATH=
COSIL_PATH=
LOCAGENT_PATH=
ORCALOCA_PATH=
AWE_AGENT_PATH=

# Optional: explicit conda binary used to launch external agents
CONDA_EXE=
